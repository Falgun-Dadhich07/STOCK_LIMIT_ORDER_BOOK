DEBUG=0
SECRET_KEY=your-very-secret-key-here-change-me

# Database — set automatically by Railway when you add a PostgreSQL plugin
DATABASE_URL=postgres://user:password@host:5432/dbname

# Redis — set automatically by Railway when you add a Redis plugin
REDIS_URL=redis://default:password@host:6379

# Allowed hosts (comma-separated, or use * for all)
ALLOWED_HOSTS=*

# CSRF — set to your Railway public URL, e.g. https://yourapp.up.railway.app
CSRF_TRUSTED_ORIGINS=https://yourapp.up.railway.app

# Email (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
